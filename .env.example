# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz
POSTGRES_DB=quiz
POSTGRES_PORT=5433

# --- API (apps/api) ---
# Port 5433 : évite un conflit avec un éventuel PostgreSQL natif déjà sur 5432
DATABASE_URL="postgresql://quiz:quiz@localhost:5433/quiz?schema=public"
PORT=3000

# JWT d'accès (courte durée, cf. claude.md §5) — en secondes
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN_SECONDS=900

# Lien de vérification d'email (JWT signé, sans état côté serveur)
JWT_EMAIL_VERIFICATION_SECRET=change-me

# Note : le refresh token n'est pas un JWT — c'est un token opaque, dont seul
# le hash est stocké en base (table refresh_tokens), ce qui permet la révocation.
# Idem pour la réinitialisation de mot de passe (token opaque à usage unique,
# hash stocké sur User).

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
